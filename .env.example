# ============================================================================
# SUPABASE POSTGRESQL CONFIGURATION
# ============================================================================
# Sign up at https://supabase.com and create a new project
# Get these values from your Supabase project settings (Settings > API)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

PORT=5000
NODE_ENV=development

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================

JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars

# ============================================================================
# GOOGLE OAUTH CONFIGURATION
# ============================================================================
# Create a Google OAuth app at https://console.cloud.google.com

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================================================
# EMAIL CONFIGURATION (NEW)
# ============================================================================
# Choose your email service below:
#
# OPTION 1: Gmail (Easiest for Development)
#   1. Enable 2FA at https://myaccount.google.com/security
#   2. Generate App Password at https://myaccount.google.com/apppasswords
#   3. Copy the 16-char password and remove spaces
#
# OPTION 2: SendGrid (Recommended for Production)
#   1. Sign up at https://sendgrid.com
#   2. Create API key at https://app.sendgrid.com/settings/api_keys
#   3. Verify sender email in Settings > Sender Authentication
#
# OPTION 3: Mailgun (Alternative Professional Service)
#   1. Sign up at https://mailgun.com
#   2. Get API key from your dashboard
#   3. Add verified domain

# Gmail Configuration (Uncomment if using Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=your-email@gmail.com

# SendGrid Configuration (Uncomment if using SendGrid)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=SG.your-api-key-here
# EMAIL_FROM=noreply@grazel.com

# Mailgun Configuration (Uncomment if using Mailgun)
# EMAIL_SERVICE=mailgun
# MAILGUN_API_KEY=key-your-key-here
# MAILGUN_DOMAIN=mail.grazel.com
# EMAIL_FROM=noreply@grazel.com

# ============================================================================
# PAYMENT GATEWAY (Razorpay)
# ============================================================================
# Get these from https://dashboard.razorpay.com/app/keys

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# ============================================================================
# FRONTEND CONFIGURATION (for CORS)
# ============================================================================

FRONTEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:3001

# ============================================================================
# VERCEL DEPLOYMENT (set these in Vercel Project Settings > Environment Variables)
# ============================================================================
# VITE_GOOGLE_CLIENT_ID=<your-client-id>   (Production + Preview)
# JWT_SECRET=<strong-random-secret>          (Production)
# SUPABASE_SERVICE_ROLE_KEY=<service-key>  (Production)
# VITE_SUPABASE_URL=<supabase-url>         (Production)
# FRONTEND_URL=https://grazel.vercel.app     (Production)
# EMAIL_SERVICE=sendgrid                     (Production - use SendGrid)
# SENDGRID_API_KEY=<your-api-key>           (Production)
# EMAIL_FROM=noreply@grazel.com             (Production)
